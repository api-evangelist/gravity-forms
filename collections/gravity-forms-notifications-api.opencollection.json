{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gravity Forms REST API v2 Entries Notifications API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send notifications",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}/wp-json/gf/v2/notifications/send"
          },
          "docs": "Send notifications"
        }
      ]
    }
  ],
  "bundled": true
}